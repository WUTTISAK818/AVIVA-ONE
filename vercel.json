{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_TARGET": "one"
  },
  "crons": [
    {
      "path": "/api/cron/report-reminder",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/report-digest-notify",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/sales-lead-digest",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/cron/sales-followup",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/lead-edit-expiry",
      "schedule": "35 1 * * *"
    },
    {
      "path": "/api/cron/line-quota",
      "schedule": "40 1 * * *"
    },
    {
      "path": "/api/cron/directive-reminder",
      "schedule": "45 1 * * *"
    },
    {
      "path": "/api/cron/booking-flow",
      "schedule": "5 2 * * *"
    },
    {
      "path": "/api/cron/construction-progress",
      "schedule": "20 2 * * *"
    }
  ]
}
